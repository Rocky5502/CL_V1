# Never commit real keys.
HF_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# API model IDs are deliberately environment-overridable.
# Freeze exact IDs in configs/frozen_models.yaml before the main run.
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=

# Optional cache roots on the 2 TB SSD
HF_HOME=./data/cache/huggingface
TRANSFORMERS_CACHE=./data/cache/huggingface
